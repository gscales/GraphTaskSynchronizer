<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GraphTaskSynchronizer</RootNamespace>
    <AssemblyName>GraphTaskSynchronizer</AssemblyName>
  </PropertyGroup>

  <!--
    Graph is called over REST (GraphRestClient) rather than through Microsoft.Graph: the SDK's
    TodoTask model has no SingleValueExtendedProperties, which is where PidLidPercentComplete
    comes back. Azure.Identity supplies the app-only token. Configuration, logging and Kestrel
    come from the ASP.NET Core shared framework.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphTaskSynchronizer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
